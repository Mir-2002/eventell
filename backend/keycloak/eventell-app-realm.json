{
  "realm": "eventell-app",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "loginTheme": "eventell",
  "roles": {
    "realm": [
      { "name": "ROLE_ORGANIZER", "description": "Creates and manages events" },
      { "name": "ROLE_ATTENDEE", "description": "Buys tickets for published events" },
      { "name": "ROLE_STAFF", "description": "Validates tickets at events" },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-eventell-app",
        "description": "Granted to every new user, including self-registered ones",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "ROLE_ATTENDEE"],
          "client": { "account": ["view-profile", "manage-account"] }
        }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-eventell-app", "composite": true },
  "clients": [
    {
      "clientId": "eventell-app",
      "name": "Eventell",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8080/*"
      }
    }
  ],
  "users": [
    {
      "username": "organizer",
      "enabled": true,
      "email": "organizer@eventell.local",
      "emailVerified": true,
      "firstName": "Olivia",
      "lastName": "Organizer",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["ROLE_ORGANIZER"]
    },
    {
      "username": "attendee",
      "enabled": true,
      "email": "attendee@eventell.local",
      "emailVerified": true,
      "firstName": "Adam",
      "lastName": "Attendee",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["ROLE_ATTENDEE"]
    },
    {
      "username": "staff",
      "enabled": true,
      "email": "staff@eventell.local",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Staff",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["ROLE_STAFF"]
    }
  ]
}
